# Copy this file to .env for local development. .env is gitignored.
#
# EXPO_PUBLIC_* variables are inlined into the bundle at build time, so they are
# not secrets — but each developer's address differs, which is why it stays local.
# Changing this value requires restarting the dev server (rebuild for EAS builds).

# Backend API base URL, including the /api suffix.
# Physical devices cannot reach "localhost" (that is the phone itself); use the
# LAN IP of the machine running the backend, e.g. http://192.168.1.20:8081/api
EXPO_PUBLIC_API_URL=http://localhost:8081/api
