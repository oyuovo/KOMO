# Copy this file to docker/.env for local development. Never commit docker/.env.
# Generate independent secrets, for example: openssl rand -base64 32

DB_NAME=komo
DB_USER=komo
DB_PASSWORD=replace-with-generated-database-password

RABBITMQ_USER=komo
RABBITMQ_PASS=replace-with-generated-rabbitmq-password

AI_INTERNAL_TOKEN=replace-with-independent-random-32-byte-secret
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EXTRACTION_ENABLED=false

JWT_SECRET=replace-with-at-least-32-random-bytes
DEEPSEEK_API_KEY=replace-with-provider-api-key

# ── Backend runtime overrides (production only) ──
# Local development works with the defaults baked into application.yml;
# these only need to be set when the backend runs behind nginx over HTTPS.
#
# Mark auth cookies Secure so tokens are never sent over plain HTTP.
# Must stay false for http://localhost or the browser drops the cookies.
# COOKIE_SECURE=true
#
# Addresses whose X-Forwarded-For / X-Real-IP the rate limiter is allowed to trust.
# Defaults to loopback (nginx on the same host). If the proxy runs elsewhere,
# add its address or IP-based login rate limiting degrades to per-proxy-address.
# TRUSTED_PROXIES=127.0.0.1,::1
#
# Hibernate DDL mode. Use `update` for first deploy (create tables), then switch
# to `validate` so Hibernate can never mutate the schema silently.
# JPA_DDL_AUTO=validate
#
# Local Python outside Docker uses QDRANT_URL=http://127.0.0.1:6333.
# The same AI_INTERNAL_TOKEN must be provided to Java and Python.
#
# CORS whitelist (comma-separated). Include the public frontend origin even
# behind nginx: Spring validates Origin headers on proxied write requests too.
# CORS_ORIGINS=https://your-domain
# 自用部署关闭自主注册；开发测试需显式开启，修改后重启Java后端。
REGISTRATION_ENABLED=false
